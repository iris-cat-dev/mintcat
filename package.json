{
  "name": "mintcat",
  "private": true,
  "version": "0.6.0",
  "channel": "beta",
  "sub-version": "4",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @mintcat/desktop-vnext dev",
    "desktop:native": "pnpm --filter @mintcat/desktop-vnext native",
    "build": "pnpm --filter @mintcat/desktop-vnext build",
    "check": "cargo check --workspace && pnpm -r --if-present check && pnpm contracts:check",
    "test": "cargo test --workspace && pnpm --filter @mintcat/sdk-ts test",
    "contracts:generate": "node packages/contracts/scripts/generate.mjs",
    "contracts:check": "node packages/contracts/scripts/generate.mjs --check",
    "runtime:target": "node scripts/runtime-target.mjs --json",
    "cli": "cargo run -p mintcat-cli --",
    "daemon": "cargo run -p mintcat-daemon --",
    "module": "cargo run -p mintcat-module --",
    "build:cli": "cargo build -p mintcat-cli --release",
    "package": "./scripts/build-release.sh",
    "package:standard": "./scripts/build-release.sh",
    "package:cli": "node scripts/package-cli.mjs",
    "package:portable": "node scripts/build-portable.mjs",
    "package:fixed-webview2": "node scripts/build-fixed-webview2.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "jsdom": "^26.1.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.11"
  }
}