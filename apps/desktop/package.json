    "@mintcat/sdk-ui": "workspace:*",
    "@tauri-apps/api": "2.9.1",
    "antd": "^6.3.4",
    "@ant-design/icons": "^6.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "typescript": "^5.2.2",
    "vite": "7.1.12"
  }
}
