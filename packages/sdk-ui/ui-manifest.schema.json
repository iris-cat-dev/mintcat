{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mintcat.work/contracts/ui-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeVersion",
    "moduleId",
    "entry",
    "css",
    "pages",
    "navigation",
    "commands",
    "settings",
    "games"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runtimeVersion": {
      "const": 1
    },
    "moduleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^ui/.+\\.m?js$"
    },
    "css": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "^ui/.+\\.css$"
      }
    },
    "pages": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "route",
          "title",
          "export",
          "stateVersion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "route": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "export": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[a-zA-Z_$][\\w$]*$"
          },
          "stateVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "navigation": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "pageId",
          "order"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "pageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "order": {
            "type": "number"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "method",
          "params"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "enableWhen": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gameId"
            ],
            "properties": {
              "gameId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        }
      }
    },
    "settings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "gameId",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "gameId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "fields": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "label",
                "type"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "type": {
                  "enum": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "games": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gameId",
          "displayName",
          "adapterContract"
        ],
        "properties": {
          "gameId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "adapterContract": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    }
  }
}
